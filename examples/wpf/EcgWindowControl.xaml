<UserControl x:Class="EcgWindow.Examples.Wpf.EcgWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="116">
    <Border Padding="16"
            CornerRadius="16"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0"
                  Visibility="{Binding ChartVisibility}">
                <Border Background="#07111F"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="12"
                        Opacity="{Binding ChartOpacity}">
                    <Grid Margin="10">
                        <Path Data="{Binding AreaGeometry}"
                              Fill="#2E34D399"
                              Stretch="Fill" />
                        <Path Data="{Binding LineGeometry}"
                              Stroke="#34D399"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Fill" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelText}"
                           Foreground="#D1D5DB"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PercentText}"
                           Margin="0,4,0,0"
                           Foreground="#F9FAFB"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding NoteText}"
                           Margin="0,4,0,0"
                           Foreground="{Binding NoteBrush}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding NoteText}"
                       Foreground="#D1D5DB"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Visibility="{Binding UnsupportedVisibility}" />
        </Grid>
    </Border>
</UserControl>
